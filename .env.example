# --- Proveedor de LLM: "gemini" (por defecto) o "groq" ---
# Ambos ofrecen un tier gratuito real, sin necesidad de tarjeta de credito ni pasarela de pago.
LLM_PROVIDER=gemini

# --- Google Gemini (Google AI Studio) ---
# Clave gratuita: https://aistudio.google.com/apikey (inicia sesion con una cuenta de Google,
# sin tarjeta). Revisa https://aistudio.google.com/ para el nombre exacto del modelo Flash
# gratuito vigente si "gemini-3.6-flash" ha quedado desactualizado (Google renombra/retira
# modelos con relativa frecuencia; el pipeline fallara con un 404 claro si esto pasa).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Groq (alternativa gratuita, modelos Llama servidos a muy baja latencia) ---
# Clave gratuita: https://console.groq.com/keys (sin tarjeta). Revisa
# https://console.groq.com/docs/models para el listado de modelos gratuitos vigentes.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Persistencia (Track Record Engine) ---
# SQLite (por defecto, cero configuracion adicional):
DATABASE_URL=sqlite:///data/macro_intel.db
# PostgreSQL (recomendado si se expone un dashboard publico con acceso concurrente):
# DATABASE_URL=postgresql+psycopg2://usuario:password@host:5432/macro_intel

# --- Ingesta ---
FETCH_TIMEOUT=15
# Opcional: email de contacto usado en el User-Agent HTTP hacia los feeds RSS (buena practica
# de scraping). Solo se envia si TU lo configuras aqui; no se usa ningun dato por defecto.
CONTACT_EMAIL=tu-email@dominio.com

# --- Motor de consenso cruzado ---
MIN_INSTITUTIONAL_DIVERSITY=2
CLUSTER_TIME_WINDOW_HOURS=48
CLUSTER_SEMANTIC_SIMILARITY=0.60

LOG_LEVEL=INFO

# --- Identidad y control de acceso (Institutional Prompt, seccion 6) ---
# "development" (por defecto) o "production". En production, si JWT_SECRET_KEY no esta
# fijado abajo, el servidor SE NIEGA A ARRANCAR (ver api/server.py:lifespan) -- un secreto
# JWT distinto en cada reinicio invalidaria todas las sesiones activas sin aviso.
ENVIRONMENT=development
# Genera uno real con: python -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacio en desarrollo, se genera uno aleatorio al arrancar (valido solo mientras
# el proceso vive). OBLIGATORIO fijarlo antes de desplegar con ENVIRONMENT=production.
JWT_SECRET_KEY=
JWT_EXPIRY_HOURS=8
